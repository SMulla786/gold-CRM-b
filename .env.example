# Copy to .env and fill in. Local PostgreSQL 18 service on localhost:5432.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/justudhari?schema=public"
# Used by tests (tester resets this DB on every run)
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/justudhari_test?schema=public"

PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Seeded platform owner (Super Admin)
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_PASSWORD="ChangeMe@123"
SEED_SUPERADMIN_EMAIL="owner@example.com"

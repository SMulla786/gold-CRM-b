// Schema v1 — tenancy, branch tree, users, RBAC, plans/subscriptions, audit.
// Owner: lead. Ask in chat.txt before changing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserLevel {
  SUPER_ADMIN
  ADMIN
  BRANCH_USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum SignupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ActivityAction {
  CREATED
  EDITED
  DELETED
  REVERSED
}

enum OtpPurpose {
  PASSWORD_RESET
  MPIN_RESET
  LOGIN
}

// ───────────── Geography (global masters) ─────────────

/// id = GST state code
model State {
  id             Int             @id
  name           String          @unique
  districts      District[]
  businesses     Business[]
  signupRequests SignupRequest[]
  branches       Branch[]
  parties        Party[]
}

model District {
  id             Int             @id @default(autoincrement())
  stateId        Int
  name           String
  state          State           @relation(fields: [stateId], references: [id])
  businesses     Business[]
  signupRequests SignupRequest[]
  branches       Branch[]
  parties        Party[]

  @@unique([stateId, name])
}

// ───────────── Platform: plans, tenants, subscriptions ─────────────

model Plan {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  description   String?
  durationDays  Int
  price         Decimal        @db.Decimal(12, 2)
  maxBranches   Int
  maxUsers      Int
  /// module keys from @ju/shared MODULES (core modules are always on)
  modules       String[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

/// Tenant = one jewellery business (customer of the platform).
model Business {
  id            Int                   @id @default(autoincrement())
  name          String
  ownerName     String
  countryCode   String                @default("+91")
  mobile        String
  email         String?
  gstin         String?
  address       String?
  stateId       Int?
  districtId    Int?
  status        BusinessStatus        @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  branches      Branch[]
  users         User[]
  roles         Role[]
  subscriptions Subscription[]
  payments      SubscriptionPayment[]
  signupRequest SignupRequest?
  parties       Party[]
  bankAccounts  BankAccount[]
  hsnCodes      BusinessHsn[]
  settings      Setting[]
  karats        KaratMapping[]
  metalRates    MetalRate[]
  rateLimits    RateLimit[]
  state         State?                @relation(fields: [stateId], references: [id])
  district      District?             @relation(fields: [districtId], references: [id])
}

/// Subscription snapshots plan limits/modules so later plan edits don't change running subscriptions.
/// Effective access = latest ACTIVE subscription whose endsAt >= now; otherwise business is read-only.
model Subscription {
  id          Int                   @id @default(autoincrement())
  businessId  Int
  planId      Int
  startsAt    DateTime
  endsAt      DateTime
  status      SubscriptionStatus    @default(ACTIVE)
  maxBranches Int
  maxUsers    Int
  modules     String[]
  notes       String?
  createdById Int?
  createdAt   DateTime              @default(now())
  business    Business              @relation(fields: [businessId], references: [id])
  plan        Plan                  @relation(fields: [planId], references: [id])
  payments    SubscriptionPayment[]

  @@index([businessId, endsAt])
}

model SubscriptionPayment {
  id             Int           @id @default(autoincrement())
  businessId     Int
  subscriptionId Int?
  amount         Decimal       @db.Decimal(12, 2)
  /// UPI | CASH | BANK | GATEWAY
  method         String
  utr            String?
  screenshotUrl  String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  recordedById   Int?
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([businessId])
}

/// Public "Create Account" form; Super Admin approves → Business + root Branch + owner User.
model SignupRequest {
  id           Int          @id @default(autoincrement())
  shopName     String
  ownerName    String
  countryCode  String       @default("+91")
  whatsapp     String
  email        String?
  address      String
  stateId      Int
  districtId   Int?
  status       SignupStatus @default(PENDING)
  businessId   Int?         @unique
  reviewedById Int?
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime     @default(now())
  business     Business?    @relation(fields: [businessId], references: [id])
  state        State        @relation(fields: [stateId], references: [id])
  district     District?    @relation(fields: [districtId], references: [id])

  @@index([status])
}

// ───────────── Tenant structure ─────────────

/// Branch tree. Root branch (parentId = null) is created with the business and owned by the owner admin.
/// path = ancestor ids incl. self, e.g. "/1/4/9/"; subtree of X = path startsWith X.path.
model Branch {
  id           Int                @id @default(autoincrement())
  businessId   Int
  parentId     Int?
  path         String
  depth        Int                @default(0)
  /// Branch-admin node: an ADMIN user attached here manages this subtree.
  isAdminNode  Boolean            @default(false)
  name         String
  code         String?
  inchargeName String?
  countryCode  String             @default("+91")
  mobile       String?
  gstin        String?
  stateId      Int?
  districtId   Int?
  address      String?
  disclaimer   String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id])
  parent       Branch?            @relation("BranchTree", fields: [parentId], references: [id])
  children     Branch[]           @relation("BranchTree")
  counters     Counter[]
  users        User[]
  extraUsers   UserBranchAccess[]
  state        State?             @relation(fields: [stateId], references: [id])
  district     District?          @relation(fields: [districtId], references: [id])

  @@index([businessId])
  @@index([path])
}

model Counter {
  id         Int      @id @default(autoincrement())
  businessId Int
  branchId   Int
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@unique([branchId, name])
  @@index([businessId])
}

// ───────────── Users & RBAC ─────────────

/// SUPER_ADMIN: businessId/branchId null.
/// ADMIN: businessId + branchId = node they administer (owner → root branch, isOwner = true).
/// BRANCH_USER: businessId + branchId (+ optional extra branches via UserBranchAccess); permissions via role + overrides.
model User {
  id            Int                @id @default(autoincrement())
  level         UserLevel
  businessId    Int?
  branchId      Int?
  isOwner       Boolean            @default(false)
  roleId        Int?
  name          String
  username      String             @unique
  email         String?            @unique
  mobile        String?
  passwordHash  String
  mpinHash      String?
  status        UserStatus         @default(ACTIVE)
  /// null = unlimited history; otherwise days of past records visible
  viewDaysLimit Int?
  lastLoginAt   DateTime?
  createdById   Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  business      Business?          @relation(fields: [businessId], references: [id])
  branch        Branch?            @relation(fields: [branchId], references: [id])
  role          Role?              @relation(fields: [roleId], references: [id])
  permissions   UserPermission[]
  extraBranches UserBranchAccess[]
  sessions      Session[]
  otps          OtpCode[]

  @@index([businessId])
  @@index([branchId])
}

model UserBranchAccess {
  userId   Int
  branchId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

/// Permission catalog seeded from @ju/shared MODULES. key = module key ("billing") or page key ("billing.sell_bill").
model Permission {
  id         Int              @id @default(autoincrement())
  key        String           @unique
  module     String
  label      String
  isModule   Boolean          @default(false)
  hasActions Boolean          @default(true)
  sort       Int
  roles      RolePermission[]
  users      UserPermission[]
}

/// Designation. businessId null = system template role (copied defaults for every business).
model Role {
  id          Int              @id @default(autoincrement())
  businessId  Int?
  name        String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  business    Business?        @relation(fields: [businessId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([businessId, name])
}

model RolePermission {
  roleId       Int
  permissionId Int
  canView      Boolean    @default(true)
  canEdit      Boolean    @default(false)
  canDelete    Boolean    @default(false)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Per-user override of the role's permission (row present = replaces role value for that permission).
model UserPermission {
  userId       Int
  permissionId Int
  canView      Boolean    @default(true)
  canEdit      Boolean    @default(false)
  canDelete    Boolean    @default(false)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// ───────────── Auth ─────────────

/// One row per refresh token (rotated on every refresh). impersonatorId set when a super admin "logs in as".
model Session {
  id               String    @id @default(uuid())
  userId           Int
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  impersonatorId   Int?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  userId     Int
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ───────────── Audit ─────────────

model ActivityLog {
  id         BigInt         @id @default(autoincrement())
  businessId Int?
  branchId   Int?
  userId     Int?
  module     String
  action     ActivityAction
  entity     String
  entityId   String
  summary    String
  partyName  String?
  meta       Json?
  createdAt  DateTime       @default(now())

  @@index([businessId, createdAt])
  @@index([branchId, createdAt])
}

model ImpersonationLog {
  id           Int       @id @default(autoincrement())
  superAdminId Int
  businessId   Int
  targetUserId Int
  reason       String?
  ip           String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([businessId])
}

// ═════════════ Phase 1 — masters & settings (spec: docs/modules/11-masters-settings.md) ═════════════

enum PartyType {
  CUSTOMER
  SUPPLIER
  KARIGAR
  WHOLESALER
}

enum MetalKind {
  GOLD
  SILVER
}

enum RateUnit {
  GRAM_1
  GRAM_10
  TOLA
  KG_1
}

enum BankApplyTo {
  ALL
  SYSTEM
  JUST_BILL
  STOCK_BILL
  STOCK_AND_JUST_BILL
}

enum HsnCategory {
  GOLD
  SILVER
  ARTIFICIAL
  STONE
  FRANCHISE
  FINDINGS
}

/// Customers / suppliers / karigars — shared across all branches of a business.
model Party {
  id              Int       @id @default(autoincrement())
  businessId      Int
  type            PartyType
  /// family sub-profile under a parent customer
  parentId        Int?
  name            String
  countryCode     String    @default("+91")
  mobile          String
  email           String?
  address         String?
  birthday        DateTime? @db.Date
  anniversary     DateTime? @db.Date
  aadhaar         String?
  pan             String?
  gstin           String?
  licenseNo       String?
  regNo           String?
  logoTitle       String?
  shopName        String?
  stateId         Int?
  districtId      Int?
  area            String?
  shopAddress     String?
  pinCode         String?
  /// karigar specialty
  specialty       String?
  photoUrl        String?
  shopLogoUrl     String?
  isActive        Boolean   @default(true)
  createdBranchId Int?
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id])
  parent          Party?    @relation("PartyFamily", fields: [parentId], references: [id])
  members         Party[]   @relation("PartyFamily")
  state           State?    @relation(fields: [stateId], references: [id])
  district        District? @relation(fields: [districtId], references: [id])

  @@index([businessId, type, name])
  @@index([businessId, mobile])
}

/// branchId 0 = available to all branches of the business.
model BankAccount {
  id         Int         @id @default(autoincrement())
  businessId Int
  branchId   Int         @default(0)
  bankName   String
  branchName String?
  accountNo  String
  ifsc       String
  applyTo    BankApplyTo @default(ALL)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  business   Business    @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

/// Global HSN master (Super Admin maintains). Businesses switch codes on/off via BusinessHsn.
model HsnCode {
  id          Int           @id @default(autoincrement())
  code        String
  category    HsnCategory
  productType String
  gstRate     Decimal       @db.Decimal(5, 2)
  isActive    Boolean       @default(true)
  businesses  BusinessHsn[]

  @@unique([code, category, productType])
}

model BusinessHsn {
  businessId Int
  hsnId      Int
  isActive   Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id])
  hsn        HsnCode  @relation(fields: [hsnId], references: [id])

  @@id([businessId, hsnId])
}

/// Key/value settings. branchId 0 = business-wide; a branch row overrides it. Keys + value shapes defined in src/shared/contracts/settings.ts.
model Setting {
  businessId  Int
  branchId    Int      @default(0)
  key         String
  value       Json
  updatedById Int?
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])

  @@id([businessId, branchId, key])
}

/// Karat/purity → touch % (24K=100, 22K=91.67 …, 999/925/800 for silver) incl. custom karats.
model KaratMapping {
  id         Int       @id @default(autoincrement())
  businessId Int
  metal      MetalKind
  code       String
  title      String
  touch      Decimal   @db.Decimal(6, 3)
  isSystem   Boolean   @default(false)
  sort       Int       @default(0)
  business   Business  @relation(fields: [businessId], references: [id])

  @@unique([businessId, metal, code])
}

/// Rate history; current rate = latest effectiveAt per (business, branch, metal, karatCode, unit). branchId 0 = business-wide.
model MetalRate {
  id          Int       @id @default(autoincrement())
  businessId  Int
  branchId    Int       @default(0)
  metal       MetalKind
  karatCode   String
  rateUnit    RateUnit
  sellRate    Decimal   @db.Decimal(14, 2)
  buyRate     Decimal   @db.Decimal(14, 2)
  effectiveAt DateTime  @default(now())
  createdById Int?
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, branchId, metal, karatCode, rateUnit, effectiveAt(sort: Desc)])
}

/// Sanity guard: billing rejects rates outside [minRate, maxRate] unless overridden.
model RateLimit {
  businessId Int
  metal      MetalKind
  rateUnit   RateUnit
  minRate    Decimal   @db.Decimal(14, 2)
  maxRate    Decimal   @db.Decimal(14, 2)
  business   Business  @relation(fields: [businessId], references: [id])

  @@id([businessId, metal, rateUnit])
}

// ═════════════ Phase 2 — inventory + ledger core (spec: docs/modules/04-inventory.md, 09-accounts-ledgers.md) ═════════════

enum StockClass {
  GOLD
  SILVER
  STONE
  ARTIFICIAL
  FRANCHISE
}

/// How an item name is stocked: LOOSE lots (weights reduce as sold), TAG pieces (one row per tagged piece), or BOTH allowed.
enum EntryMethod {
  LOOSE
  TAG
  BOTH
}

enum StockStatus {
  AVAILABLE
  SOLD
  RESERVED
  ISSUED
  TRANSFERRED
  DELETED
}

enum ChargeUnit {
  PER_GRAM
  PERCENT
  FIXED
}

enum LedgerAsset {
  MONEY
  GOLD
  SILVER
  STONE
  ARTIFICIAL
  FRANCHISE
}

enum Direction {
  IN
  OUT
}

/// Metal flavour on metal ledger rows (justudhari: Usual / Bullion, plus kacha = old/unrefined).
enum MetalForm {
  USUAL
  BULLION
  KACHA
}

/// Jewellery type / collection (Chains, Rings, …). businessId null = global list (Super Admin), else business custom.
model JewelleryType {
  id         Int         @id @default(autoincrement())
  businessId Int?
  stockClass StockClass?
  name       String
  isActive   Boolean     @default(true)
  groups     ItemGroup[]

  @@unique([businessId, name])
}

model ItemGroup {
  id              Int            @id @default(autoincrement())
  businessId      Int
  stockClass      StockClass
  jewelleryTypeId Int?
  name            String
  hsnId           Int?
  gstRate         Decimal        @default(3) @db.Decimal(5, 2)
  minWeight       Decimal?       @db.Decimal(14, 3)
  maxWeight       Decimal?       @db.Decimal(14, 3)
  minPcs          Int?
  maxPcs          Int?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  jewelleryType   JewelleryType? @relation(fields: [jewelleryTypeId], references: [id])
  items           ItemName[]
  stock           StockItem[]

  @@unique([businessId, stockClass, name])
}

model ItemName {
  id            Int         @id @default(autoincrement())
  businessId    Int
  groupId       Int
  name          String
  hsnId         Int?
  taxValue      Decimal?    @db.Decimal(8, 2)
  /// PERCENT or FIXED (Rs) — overrides group GST when set
  taxUnit       ChargeUnit?
  method        EntryMethod @default(BOTH)
  tagPrefix     String?
  tagDigits     Int?
  minWeight     Decimal?    @db.Decimal(14, 3)
  maxWeight     Decimal?    @db.Decimal(14, 3)
  minPcs        Int?
  maxPcs        Int?
  /// "Default sale value" pre-filled on billing
  defKaratCode  String?
  defTunch      Decimal?    @db.Decimal(6, 3)
  defWastage    Decimal?    @db.Decimal(6, 3)
  defLabour     Decimal?    @db.Decimal(12, 2)
  defLabourUnit ChargeUnit?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  group         ItemGroup   @relation(fields: [groupId], references: [id])
  stock         StockItem[]

  @@unique([businessId, groupId, name])
}

/// Atomic tag numbering per (business, prefix): increment with UPDATE … RETURNING inside the stock-entry tx.
model TagSequence {
  businessId Int
  prefix     String
  next       Int    @default(1)

  @@id([businessId, prefix])
}

/// One row = one tagged piece (TAG) or one loose lot (LOOSE, quantities decrease as it is sold/issued).
model StockItem {
  id           Int         @id @default(autoincrement())
  businessId   Int
  branchId     Int
  stockClass   StockClass
  groupId      Int
  itemNameId   Int
  method       EntryMethod
  tagNo        String?
  huid         String?
  karatCode    String?
  pcs          Int         @default(0)
  gross        Decimal     @default(0) @db.Decimal(14, 3)
  less         Decimal     @default(0) @db.Decimal(14, 3)
  net          Decimal     @default(0) @db.Decimal(14, 3)
  tunch        Decimal     @default(0) @db.Decimal(6, 3)
  wastage      Decimal     @default(0) @db.Decimal(6, 3)
  fine         Decimal     @default(0) @db.Decimal(14, 3)
  stoneCharge  Decimal     @default(0) @db.Decimal(14, 2)
  labour       Decimal     @default(0) @db.Decimal(12, 2)
  labourUnit   ChargeUnit  @default(PER_GRAM)
  other        Decimal     @default(0) @db.Decimal(14, 2)
  /// sale rate override (else today's rate); purchase cost for valuation/margin
  rate         Decimal?    @db.Decimal(14, 2)
  purchaseCost Decimal?    @db.Decimal(14, 2)
  status       StockStatus @default(AVAILABLE)
  /// LedgerSource that created it (PURCHASE_BILL, IMPORT, STOCK_INSERT, ORDER_RECEIVE, STOCK_TRANSFER) + document id
  source       String
  sourceId     String?
  /// groups rows saved together in one "New Stock" entry
  entryNo      Int?
  photoUrl     String?
  remarks      String?
  soldAt       DateTime?
  createdById  Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  group        ItemGroup   @relation(fields: [groupId], references: [id])
  itemName     ItemName    @relation(fields: [itemNameId], references: [id])

  @@unique([businessId, tagNo])
  @@index([businessId, branchId, stockClass, status])
  @@index([businessId, huid])
}

/// Every money / stock movement in every module. Day-Book, asset ledgers, balances and dashboards read from here.
/// Never update or delete rows: corrections are new rows with reversalOfId set.
model LedgerEntry {
  id            BigInt      @id @default(autoincrement())
  businessId    Int
  branchId      Int
  /// business date of the transaction (Day-Book date), not insert time
  txnDate       DateTime    @db.Date
  asset         LedgerAsset
  direction     Direction
  /// MONEY: null = shop cash, else BankAccount.id
  bankAccountId Int?
  metalForm     MetalForm?
  karatCode     String?
  pcs           Int?
  gross         Decimal?    @db.Decimal(14, 3)
  net           Decimal?    @db.Decimal(14, 3)
  fine          Decimal?    @db.Decimal(14, 3)
  /// MONEY amount, or value of the stock movement
  amount        Decimal?    @db.Decimal(14, 2)
  /// LedgerSource enum value from src/shared/enums.ts
  source        String
  sourceId      String
  partyId       Int?
  stockItemId   Int?
  narration     String?
  reversalOfId  BigInt?
  createdById   Int?
  createdAt     DateTime    @default(now())

  @@index([businessId, branchId, asset, txnDate])
  @@index([businessId, source, sourceId])
  @@index([businessId, partyId])
  @@index([businessId, stockItemId])
}

// ═════════════ Phase 3 — accounts (spec: docs/modules/09-accounts-ledgers.md) ═════════════
// Day-Book and asset ledgers are computed from LedgerEntry; no table needed.

enum DayStatus {
  OPEN
  CLOSED
}

/// TASK-80: per-branch day open/close. Balances stay derived from LedgerEntry; this row only gates postings
/// (lib/ledger.post rejects a txnDate whose branch-day is CLOSED). Reopen = set status back to OPEN.
model DayBook {
  id         Int       @id @default(autoincrement())
  businessId Int
  branchId   Int
  date       DateTime  @db.Date
  status     DayStatus @default(OPEN)
  openedAt   DateTime?
  openedById Int?
  closedAt   DateTime?
  closedById Int?

  @@unique([businessId, branchId, date])
  @@index([businessId, branchId])
}

enum IncomeExpenseType {
  INCOME
  EXPENSE
}

/// Header for a manual income/expense entry; its money/metal movements are LedgerEntry rows (source INCOME_EXPENSE, sourceId = id).
model IncomeExpense {
  id            Int               @id @default(autoincrement())
  businessId    Int
  branchId      Int
  txnDate       DateTime          @db.Date
  type          IncomeExpenseType
  reason        String
  cash          Decimal           @default(0) @db.Decimal(14, 2)
  online        Decimal           @default(0) @db.Decimal(14, 2)
  bankAccountId Int?
  gold          Decimal           @default(0) @db.Decimal(14, 3)
  silver        Decimal           @default(0) @db.Decimal(14, 3)
  remark        String?
  isDeleted     Boolean           @default(false)
  createdById   Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([businessId, branchId, txnDate])
}

/// Inter-branch stock transfer (Phase 2b; not in justudhari). Whole items move: StockItem.branchId changes,
/// ledger posts OUT at fromBranch + IN at toBranch (source STOCK_TRANSFER, sourceId = id). Both branches must be in the user's subtree.
model StockTransfer {
  id           Int      @id @default(autoincrement())
  businessId   Int
  transferNo   Int
  fromBranchId Int
  toBranchId   Int
  txnDate      DateTime @db.Date
  itemCount    Int
  remarks      String?
  createdById  Int?
  createdAt    DateTime @default(now())

  @@unique([businessId, transferNo])
  @@index([businessId, fromBranchId])
  @@index([businessId, toBranchId])
}

// ───────────── Phase 4: billing ─────────────

enum BillKind {
  SELL
  PURCHASE
}

/// GST invoice vs ROUGH estimate: separate number series, ROUGH has no GST
enum BillType {
  GST
  ROUGH
}

enum BillStatus {
  ACTIVE
  DELETED
}

/// what an unpaid / overpaid bill balance is kept as in the party udhar account
enum KeepBalanceAs {
  MONEY
  GOLD
  SILVER
}

enum DiscountUnit {
  FIXED
  PERCENT
}

enum BillPaymentMode {
  CASH
  ONLINE
  METAL
}

/// Gap-free per-branch document numbering (bills, udhar). key e.g. "SELL:GST:2026-27"; incremented by an atomic upsert inside the document tx.
model DocSequence {
  businessId Int
  branchId   Int
  key        String
  next       Int    @default(1)

  @@id([businessId, branchId, key])
}

model Bill {
  id                Int               @id @default(autoincrement())
  businessId        Int
  branchId          Int
  kind              BillKind
  billType          BillType
  /// formatted per invoice settings, e.g. INV/2026-27/00001
  billNo            String
  seq               Int
  partyId           Int
  billDate          DateTime          @db.Date
  dueDate           DateTime?         @db.Date
  /// GST computed as IGST (party state differs from branch/business state)
  interState        Boolean           @default(false)
  sub               Decimal           @db.Decimal(14, 2)
  discount          Decimal           @default(0) @db.Decimal(14, 2)
  discountUnit      DiscountUnit      @default(FIXED)
  discountAmount    Decimal           @default(0) @db.Decimal(14, 2)
  gstPercent        Decimal           @default(0) @db.Decimal(5, 2)
  /// TASK-97 GST: ITC eligibility (purchase), supplier's own invoice no (2B match key), supply category, RCM
  itcEligibility    ItcEligibility    @default(ELIGIBLE)
  itcBlockReason    String?
  supplierInvoiceNo String?
  supplyCategory    GstSupplyCategory @default(TAXABLE)
  reverseCharge     Boolean           @default(false)
  taxable           Decimal           @db.Decimal(14, 2)
  cgst              Decimal           @default(0) @db.Decimal(14, 2)
  sgst              Decimal           @default(0) @db.Decimal(14, 2)
  igst              Decimal           @default(0) @db.Decimal(14, 2)
  total             Decimal           @db.Decimal(14, 2)
  round             Decimal           @default(0) @db.Decimal(8, 2)
  final             Decimal           @db.Decimal(14, 2)
  /// sum of active payments (money value), kept in step with every payment add/reverse
  paid              Decimal           @default(0) @db.Decimal(14, 2)
  keepBalanceAs     KeepBalanceAs     @default(MONEY)
  /// rate per rate-unit used to convert the balance to metal (GOLD/SILVER keep)
  keepRate          Decimal?          @db.Decimal(14, 2)
  keepWeight        Decimal?          @db.Decimal(14, 3)
  remark            String?
  status            BillStatus        @default(ACTIVE)
  /// set on delete: true = stock returned (sell: AVAILABLE again, purchase: DELETED)
  deletedWithStock  Boolean?
  deletedAt         DateTime?
  createdById       Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             BillItem[]
  payments          BillPayment[]

  @@unique([businessId, branchId, kind, billType, billNo])
  @@index([businessId, branchId, kind, billDate])
  @@index([businessId, partyId])
}

model BillItem {
  id           Int          @id @default(autoincrement())
  billId       Int
  /// SELL: the stock item sold (null = direct item not in stock); PURCHASE: the stock item created
  stockItemId  Int?
  itemNameId   Int?
  groupId      Int?
  stockClass   StockClass
  description  String
  hsnCode      String?
  tagNo        String?
  karatCode    String?
  pcs          Int          @default(1)
  gross        Decimal      @db.Decimal(14, 3)
  less         Decimal      @default(0) @db.Decimal(14, 3)
  net          Decimal      @db.Decimal(14, 3)
  tunch        Decimal      @default(100) @db.Decimal(6, 3)
  wastage      Decimal      @default(0) @db.Decimal(6, 3)
  fine         Decimal      @db.Decimal(14, 3)
  stoneCharge  Decimal      @default(0) @db.Decimal(14, 2)
  rate         Decimal      @default(0) @db.Decimal(14, 2)
  labour       Decimal      @default(0) @db.Decimal(12, 2)
  labourUnit   ChargeUnit   @default(PER_GRAM)
  other        Decimal      @default(0) @db.Decimal(14, 2)
  discount     Decimal      @default(0) @db.Decimal(14, 2)
  discountUnit DiscountUnit @default(FIXED)
  metalAmount  Decimal      @db.Decimal(14, 2)
  labourAmount Decimal      @db.Decimal(14, 2)
  total        Decimal      @db.Decimal(14, 2)
  bill         Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([stockItemId])
}

model BillPayment {
  id            Int             @id @default(autoincrement())
  billId        Int
  mode          BillPaymentMode
  bankAccountId Int?
  /// METAL payments
  metal         MetalKind?
  metalForm     MetalForm?
  gross         Decimal?        @db.Decimal(14, 3)
  net           Decimal?        @db.Decimal(14, 3)
  tunch         Decimal?        @db.Decimal(6, 3)
  fine          Decimal?        @db.Decimal(14, 3)
  rate          Decimal?        @db.Decimal(14, 2)
  /// money value of the payment (METAL: fine x rate / unit)
  amount        Decimal         @db.Decimal(14, 2)
  remark        String?
  txnDate       DateTime        @db.Date
  /// false after the bill is deleted (ledger reversed)
  isActive      Boolean         @default(true)
  /// set when the payment came from a New Udhar entry that settled this bill
  udharTxnId    Int?
  createdById   Int?
  createdAt     DateTime        @default(now())
  bill          Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

// ───────────── Phase 5: udhari (party accounts) ─────────────

/// Append-only party account movements in three units, written ONLY via lib/udhar.ts post/reverse (same pattern as LedgerEntry).
/// Sign: + = party owes the shop, - = shop owes the party. Balance = sum.
model UdharEntry {
  id           BigInt   @id @default(autoincrement())
  businessId   Int
  branchId     Int
  partyId      Int
  txnDate      DateTime @db.Date
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  gold         Decimal  @default(0) @db.Decimal(14, 3)
  silver       Decimal  @default(0) @db.Decimal(14, 3)
  /// LedgerSource (SELL_BILL, PURCHASE_BILL, UDHAR, BHAV_CUT ...) + document id
  source       String
  sourceId     String
  narration    String?
  reversalOfId BigInt?
  createdById  Int?
  createdAt    DateTime @default(now())

  @@index([businessId, partyId, txnDate])
  @@index([businessId, branchId, txnDate])
  @@index([businessId, source, sourceId])
}

enum BhavDirection {
  MONEY_TO_METAL
  METAL_TO_MONEY
}

/// One "New Udhar" form save. Posts LedgerEntry (shop cash/bank/metal) + UdharEntry (party balance).
model UdharTxn {
  id            Int            @id @default(autoincrement())
  businessId    Int
  branchId      Int
  txnNo         Int
  partyId       Int
  txnDate       DateTime       @db.Date
  /// given to the party (party owes more)
  cashOut       Decimal        @default(0) @db.Decimal(14, 2)
  onlineOut     Decimal        @default(0) @db.Decimal(14, 2)
  outBankId     Int?
  /// received from the party (party owes less)
  cashIn        Decimal        @default(0) @db.Decimal(14, 2)
  onlineIn      Decimal        @default(0) @db.Decimal(14, 2)
  inBankId      Int?
  goldOut       Decimal        @default(0) @db.Decimal(14, 3)
  goldIn        Decimal        @default(0) @db.Decimal(14, 3)
  silverOut     Decimal        @default(0) @db.Decimal(14, 3)
  silverIn      Decimal        @default(0) @db.Decimal(14, 3)
  /// bhav cut: converts part of the party balance between money and metal (no shop asset movement)
  bhavDirection BhavDirection?
  bhavMetal     MetalKind?
  bhavAmount    Decimal?       @db.Decimal(14, 2)
  bhavRate      Decimal?       @db.Decimal(14, 2)
  bhavUnitGrams Decimal?       @db.Decimal(10, 4)
  bhavWeight    Decimal?       @db.Decimal(14, 3)
  /// received money applied to this bill (adds a BillPayment)
  settleBillId  Int?
  remark        String?
  isDeleted     Boolean        @default(false)
  createdById   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([businessId, branchId, txnNo])
  @@index([businessId, partyId])
}

// ───────────── Phase 7: Just Bill + showroom drafts ─────────────

enum QtyUnit {
  GRAM
  PCS
}

/// Quick calculator bill not tied to stock (docs/modules/02 §2.3). Payments move shop cash/metal; balance goes to the party udhar when a party is linked.
model JustBill {
  id             Int               @id @default(autoincrement())
  businessId     Int
  branchId       Int
  billNo         String
  seq            Int
  /// optional link; walk-in customers use customerName/mobile only
  partyId        Int?
  customerName   String
  mobile         String?
  billDate       DateTime          @db.Date
  interState     Boolean           @default(false)
  sub            Decimal           @db.Decimal(14, 2)
  discount       Decimal           @default(0) @db.Decimal(14, 2)
  discountUnit   DiscountUnit      @default(FIXED)
  discountAmount Decimal           @default(0) @db.Decimal(14, 2)
  gstPercent     Decimal           @default(0) @db.Decimal(5, 2)
  taxable        Decimal           @db.Decimal(14, 2)
  cgst           Decimal           @default(0) @db.Decimal(14, 2)
  sgst           Decimal           @default(0) @db.Decimal(14, 2)
  igst           Decimal           @default(0) @db.Decimal(14, 2)
  total          Decimal           @db.Decimal(14, 2)
  round          Decimal           @default(0) @db.Decimal(8, 2)
  final          Decimal           @db.Decimal(14, 2)
  paid           Decimal           @default(0) @db.Decimal(14, 2)
  remark         String?
  status         BillStatus        @default(ACTIVE)
  deletedAt      DateTime?
  createdById    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          JustBillItem[]
  payments       JustBillPayment[]

  @@unique([businessId, branchId, billNo])
  @@index([businessId, branchId, billDate])
  @@index([businessId, partyId])
}

model JustBillItem {
  id         Int        @id @default(autoincrement())
  justBillId Int
  name       String
  /// display label: 24K / 22K / Custom text
  karat      String?
  /// purity % (tunch)
  purity     Decimal?   @db.Decimal(6, 3)
  quantity   Decimal    @db.Decimal(14, 3)
  unit       QtyUnit    @default(GRAM)
  /// per gram (GRAM) or per piece (PCS)
  rate       Decimal    @default(0) @db.Decimal(14, 2)
  making     Decimal    @default(0) @db.Decimal(12, 2)
  makingUnit ChargeUnit @default(PER_GRAM)
  other      Decimal    @default(0) @db.Decimal(14, 2)
  total      Decimal    @db.Decimal(14, 2)
  justBill   JustBill   @relation(fields: [justBillId], references: [id], onDelete: Cascade)

  @@index([justBillId])
}

model JustBillPayment {
  id            Int             @id @default(autoincrement())
  justBillId    Int
  mode          BillPaymentMode
  bankAccountId Int?
  metal         MetalKind?
  /// BULLION = metal received, KACHA = old gold/silver
  metalForm     MetalForm?
  gross         Decimal?        @db.Decimal(14, 3)
  net           Decimal?        @db.Decimal(14, 3)
  tunch         Decimal?        @db.Decimal(6, 3)
  fine          Decimal?        @db.Decimal(14, 3)
  rate          Decimal?        @db.Decimal(14, 2)
  amount        Decimal         @db.Decimal(14, 2)
  remark        String?
  txnDate       DateTime        @db.Date
  isActive      Boolean         @default(true)
  createdById   Int?
  createdAt     DateTime        @default(now())
  justBill      JustBill        @relation(fields: [justBillId], references: [id], onDelete: Cascade)

  @@index([justBillId])
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  BILLED
  EXPIRED
  CANCELLED
}

/// Showroom cart → manager discount approval → cashier bills it (docs/modules/02 §2.7). Items are NOT reserved; billing re-checks availability.
model SalesDraft {
  id                    Int              @id @default(autoincrement())
  businessId            Int
  branchId              Int
  draftNo               Int
  /// salesperson = creator
  createdById           Int
  partyId               Int?
  customerName          String
  mobile                String?
  /// estimate at draft time (current rates), display only — the bill recomputes
  estTotal              Decimal          @db.Decimal(14, 2)
  requestedDiscount     Decimal          @default(0) @db.Decimal(14, 2)
  requestedDiscountUnit DiscountUnit     @default(FIXED)
  note                  String?
  status                DraftStatus      @default(PENDING)
  approvedDiscount      Decimal?         @db.Decimal(14, 2)
  approvedDiscountUnit  DiscountUnit?
  rejectionReason       String?
  decidedById           Int?
  decidedAt             DateTime?
  /// set when billed
  billId                Int?
  /// end of the business day it was created; PENDING/APPROVED past this → EXPIRED (computed on read)
  expiresAt             DateTime
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  items                 SalesDraftItem[]

  @@unique([businessId, branchId, draftNo])
  @@index([businessId, branchId, status])
}

model SalesDraftItem {
  id          Int        @id @default(autoincrement())
  draftId     Int
  stockItemId Int
  draft       SalesDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

// ───────────── Phase 8: customer orders + karigar job work + repair ─────────────

enum OrderStatus {
  PENDING
  IN_PROCESS
  READY
  DELIVERED
  CANCELLED
}

enum OrderRateType {
  FIXED
  ON_DELIVERY
}

enum OrderItemStatus {
  PENDING
  ASSIGNED
  RECEIVED
  DELIVERED
}

model Order {
  id           Int            @id @default(autoincrement())
  businessId   Int
  branchId     Int
  orderNo      Int
  partyId      Int
  orderDate    DateTime       @db.Date
  deliveryDate DateTime?      @db.Date
  rateType     OrderRateType  @default(ON_DELIVERY)
  /// FIXED: rate per settings unit locked at order time
  goldRate     Decimal?       @db.Decimal(14, 2)
  silverRate   Decimal?       @db.Decimal(14, 2)
  isUrgent     Boolean        @default(false)
  designUrl    String?
  remark       String?
  /// TASK-97 order-level misc charges (Rs), added to estTotal
  miscCharges  Decimal        @default(0) @db.Decimal(14, 2)
  status       OrderStatus    @default(PENDING)
  estTotal     Decimal        @default(0) @db.Decimal(14, 2)
  /// money value of active advances
  advance      Decimal        @default(0) @db.Decimal(14, 2)
  billId       Int?
  createdById  Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        OrderItem[]
  payments     OrderPayment[]

  @@unique([businessId, branchId, orderNo])
  @@index([businessId, branchId, status])
  @@index([businessId, partyId])
}

model OrderItem {
  id              Int             @id @default(autoincrement())
  orderId         Int
  itemNameId      Int
  metal           MetalKind
  karatCode       String?
  touch           Decimal         @db.Decimal(6, 3)
  size            String?
  pcs             Int             @default(1)
  gross           Decimal         @db.Decimal(14, 3)
  less            Decimal         @default(0) @db.Decimal(14, 3)
  net             Decimal         @db.Decimal(14, 3)
  wastage         Decimal         @default(0) @db.Decimal(6, 3)
  fine            Decimal         @db.Decimal(14, 3)
  making          Decimal         @default(0) @db.Decimal(12, 2)
  makingUnit      ChargeUnit      @default(PER_GRAM)
  other           Decimal         @default(0) @db.Decimal(14, 2)
  /// TASK-97: flat labour Rs per line, wastage in grams, jewellery type
  labour          Decimal         @default(0) @db.Decimal(12, 2)
  wastageGm       Decimal         @default(0) @db.Decimal(14, 3)
  jewelleryTypeId Int?
  estTotal        Decimal         @default(0) @db.Decimal(14, 2)
  remark          String?
  status          OrderItemStatus @default(PENDING)
  karigarIssueId  Int?
  /// finished piece created on karigar receive (StockItem RESERVED, source ORDER_RECEIVE)
  stockItemId     Int?
  returnedGross   Decimal?        @db.Decimal(14, 3)
  returnedNet     Decimal?        @db.Decimal(14, 3)
  returnedFine    Decimal?        @db.Decimal(14, 3)
  /// fine weight the karigar is allowed to lose (ghat)
  ghatAllowance   Decimal?        @db.Decimal(14, 3)
  karigarLabour   Decimal?        @db.Decimal(12, 2)
  receivedAt      DateTime?
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([karigarIssueId])
}

model OrderPayment {
  id            Int             @id @default(autoincrement())
  orderId       Int
  mode          BillPaymentMode
  bankAccountId Int?
  metal         MetalKind?
  metalForm     MetalForm?
  gross         Decimal?        @db.Decimal(14, 3)
  net           Decimal?        @db.Decimal(14, 3)
  tunch         Decimal?        @db.Decimal(6, 3)
  fine          Decimal?        @db.Decimal(14, 3)
  rate          Decimal?        @db.Decimal(14, 2)
  amount        Decimal         @db.Decimal(14, 2)
  remark        String?
  txnDate       DateTime        @db.Date
  isActive      Boolean         @default(true)
  createdById   Int?
  createdAt     DateTime        @default(now())
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum KarigarIssueStatus {
  OPEN
  RECEIVED
  CANCELLED
}

/// Work + material handed to a karigar (Party type KARIGAR) for one or more order items.
model KarigarIssue {
  id             Int                @id @default(autoincrement())
  businessId     Int
  branchId       Int
  issueNo        Int
  karigarId      Int
  issueDate      DateTime           @db.Date
  dueDate        DateTime?          @db.Date
  goldFine       Decimal            @default(0) @db.Decimal(14, 3)
  silverFine     Decimal            @default(0) @db.Decimal(14, 3)
  cash           Decimal            @default(0) @db.Decimal(14, 2)
  online         Decimal            @default(0) @db.Decimal(14, 2)
  bankAccountId  Int?
  remark         String?
  wastagePercent Decimal?           @db.Decimal(6, 3)
  wastageGm      Decimal?           @db.Decimal(14, 3)
  status         KarigarIssueStatus @default(OPEN)
  createdById    Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([businessId, branchId, issueNo])
  @@index([businessId, karigarId])
}

enum RepairStatus {
  RECEIVED
  IN_PROGRESS
  IN_REVIEW
  READY
  DELIVERED
  CANCELLED
}

enum RepairPriority {
  NORMAL
  URGENT
  EXPRESS
}

/// Customer's own piece in for repair — never shop stock. Shop metal added (solder) is a shop GOLD/SILVER OUT.
model RepairTicket {
  id             Int            @id @default(autoincrement())
  businessId     Int
  branchId       Int
  ticketNo       Int
  partyId        Int
  /// GOLD / SILVER / OTHER
  metal          String
  category       String
  description    String
  pcs            Int            @default(1)
  gross          Decimal        @db.Decimal(14, 3)
  net            Decimal?       @db.Decimal(14, 3)
  karatCode      String?
  hallmark       String?
  purity         Decimal?       @db.Decimal(5, 2)
  subCategory    String?
  photoUrl       String?
  expectedDate   DateTime       @db.Date
  priority       RepairPriority @default(NORMAL)
  status         RepairStatus   @default(RECEIVED)
  karigarId      Int?
  labourCharge   Decimal        @default(0) @db.Decimal(12, 2)
  otherCharge    Decimal        @default(0) @db.Decimal(12, 2)
  advanceCash    Decimal        @default(0) @db.Decimal(14, 2)
  advanceOnline  Decimal        @default(0) @db.Decimal(14, 2)
  advanceBankId  Int?
  finalWeight    Decimal?       @db.Decimal(14, 3)
  remarks        String?
  addedMetal     MetalKind?
  addedFine      Decimal?       @db.Decimal(14, 3)
  addedRate      Decimal?       @db.Decimal(14, 2)
  addedKaratCode String?
  deliveryCash   Decimal?       @db.Decimal(14, 2)
  deliveryOnline Decimal?       @db.Decimal(14, 2)
  deliveryBankId Int?
  deliveredAt    DateTime?
  createdById    Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([businessId, branchId, ticketNo])
  @@index([businessId, branchId, status])
}

// ───────────── Phase 9: girvi (pledge loans) ─────────────

enum InterestType {
  SI
  CI
}

enum InterestPeriod {
  MONTHLY
  ANNUAL
}

enum CiPeriod {
  DAILY
  MONTHLY
  HALF_YEARLY
  YEARLY
}

enum InterestMethod {
  FULL_MONTH
  DAY_WISE
}

enum GirviStatus {
  ACTIVE
  CLOSED
}

enum GirviItemStatus {
  PLEDGED
  RELEASED
}

enum GirviTxnType {
  GRANT
  TOPUP
  INTEREST
  RELEASE
}

/// One loan agreement with pledged items. Interest accrues on the outstanding principal from interestFrom.
model GirviBatch {
  id                 Int            @id @default(autoincrement())
  businessId         Int
  branchId           Int
  girviNo            Int
  partyId            Int
  issueDate          DateTime       @db.Date
  tenureMonths       Int            @default(12)
  returnDate         DateTime       @db.Date
  ratePercent        Decimal        @db.Decimal(6, 3)
  ratePeriod         InterestPeriod @default(MONTHLY)
  interestType       InterestType   @default(SI)
  ciPeriod           CiPeriod?
  method             InterestMethod @default(DAY_WISE)
  valuation          Decimal        @db.Decimal(14, 2)
  /// outstanding principal (grant + top-ups − principal repaid)
  principal          Decimal        @db.Decimal(14, 2)
  /// interest is settled up to this date; accrues from here
  interestFrom       DateTime       @db.Date
  /// owner-approved extras (2026-10-26): fixed first-month interest; penalty % per month after returnDate
  firstMonthInterest Decimal        @default(0) @db.Decimal(14, 2)
  penaltyRatePercent Decimal        @default(0) @db.Decimal(6, 3)
  status             GirviStatus    @default(ACTIVE)
  docUrl             String?
  remark             String?
  closedAt           DateTime?
  createdById        Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  items              GirviItem[]
  txns               GirviTxn[]

  @@unique([businessId, branchId, girviNo])
  @@index([businessId, branchId, status])
  @@index([businessId, partyId])
}

model GirviItem {
  id          Int                 @id @default(autoincrement())
  batchId     Int
  category    String
  name        String
  photoUrl    String?
  gross       Decimal             @db.Decimal(14, 3)
  net         Decimal             @db.Decimal(14, 3)
  purity      Decimal             @db.Decimal(6, 3)
  fine        Decimal             @db.Decimal(14, 3)
  /// valuation rate per gram of fine
  rate        Decimal             @db.Decimal(14, 2)
  valuation   Decimal             @db.Decimal(14, 2)
  /// per-item interest % (overrides the loan rate, valuation-weighted)
  ratePercent Decimal?            @db.Decimal(6, 3)
  status      GirviItemStatus     @default(PLEDGED)
  releasedAt  DateTime?
  batch       GirviBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transfers   GirviTransferItem[]

  @@index([batchId])
}

/// Phase 9b — re-pledge: customers' pledged items handed to a lender against money received; returned when repaid.
enum GirviTransferStatus {
  ACTIVE
  RETURNED
}

model GirviTransfer {
  id                  Int                 @id @default(autoincrement())
  businessId          Int
  branchId            Int
  transferNo          Int
  /// the lender (a party, usually a supplier)
  lenderPartyId       Int
  transferDate        DateTime            @db.Date
  tenureMonths        Int                 @default(12)
  returnDate          DateTime            @db.Date
  ratePercent         Decimal             @db.Decimal(6, 3)
  ratePeriod          InterestPeriod      @default(MONTHLY)
  interestType        InterestType        @default(SI)
  ciPeriod            CiPeriod?
  method              InterestMethod      @default(DAY_WISE)
  /// money received from the lender
  principal           Decimal             @db.Decimal(14, 2)
  cash                Decimal             @default(0) @db.Decimal(14, 2)
  online              Decimal             @default(0) @db.Decimal(14, 2)
  bankAccountId       Int?
  status              GirviTransferStatus @default(ACTIVE)
  /// receive-back: date, interest paid to the lender, how it was paid
  returnedOn          DateTime?           @db.Date
  interestPaid        Decimal             @default(0) @db.Decimal(14, 2)
  returnCash          Decimal             @default(0) @db.Decimal(14, 2)
  returnOnline        Decimal             @default(0) @db.Decimal(14, 2)
  returnBankAccountId Int?
  remark              String?
  createdById         Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  items               GirviTransferItem[]

  @@unique([businessId, branchId, transferNo])
  @@index([businessId, branchId, status])
  @@index([businessId, lenderPartyId])
}

/// Items in a transfer (kept after return as history). An item is "with the lender" while its transfer is ACTIVE.
model GirviTransferItem {
  id          Int           @id @default(autoincrement())
  transferId  Int
  girviItemId Int
  transfer    GirviTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  girviItem   GirviItem     @relation(fields: [girviItemId], references: [id])

  @@unique([transferId, girviItemId])
  @@index([girviItemId])
}

model GirviTxn {
  id            Int          @id @default(autoincrement())
  batchId       Int
  type          GirviTxnType
  txnDate       DateTime     @db.Date
  /// GRANT/TOPUP: paid out to the customer; RELEASE: principal received back
  principal     Decimal      @default(0) @db.Decimal(14, 2)
  /// interest received
  interest      Decimal      @default(0) @db.Decimal(14, 2)
  discount      Decimal      @default(0) @db.Decimal(14, 2)
  cash          Decimal      @default(0) @db.Decimal(14, 2)
  online        Decimal      @default(0) @db.Decimal(14, 2)
  bankAccountId Int?
  /// RELEASE: GirviItem ids released in this txn
  itemIds       Int[]
  remark        String?
  isReversed    Boolean      @default(false)
  createdById   Int?
  createdAt     DateTime     @default(now())
  batch         GirviBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

// ───────────── Phase 10: exchange / kacha processing, buy-sell, bhav booking (docs/api-phase10.md) ─────────────
// Old metal is a ledger balance (LedgerEntry.metalForm KACHA → BULLION), never StockItem rows.

/// BUY = party → shop (shop receives metal, pays). SELL = shop → party.
enum TradeSide {
  BUY
  SELL
}

enum KachaProcessType {
  MELT
  REFINE
}

enum BhavStatus {
  PENDING
  PARTIAL
  DELIVERED
  CANCELLED
}

model Exchange {
  id            Int            @id @default(autoincrement())
  businessId    Int
  branchId      Int
  exchangeNo    Int
  side          TradeSide
  partyId       Int
  metal         MetalKind
  txnDate       DateTime       @db.Date
  /// Σ line fine
  totalFine     Decimal        @db.Decimal(14, 3)
  /// signed ± adjustment
  diffFine      Decimal        @default(0) @db.Decimal(14, 3)
  /// totalFine + diffFine — the kacha fine that moves
  afterFine     Decimal        @db.Decimal(14, 3)
  /// settings units (gold /10 g, silver /1 kg); 0 = settled as metal credit
  rate          Decimal        @default(0) @db.Decimal(14, 2)
  charges       Decimal        @default(0) @db.Decimal(14, 2)
  discount      Decimal        @default(0) @db.Decimal(14, 2)
  /// metal value + charges − discount (0 when rate = 0)
  finalAmount   Decimal        @default(0) @db.Decimal(14, 2)
  cash          Decimal        @default(0) @db.Decimal(14, 2)
  online        Decimal        @default(0) @db.Decimal(14, 2)
  bankAccountId Int?
  remark        String?
  createdById   Int?
  createdAt     DateTime       @default(now())
  lines         ExchangeLine[]

  @@unique([businessId, branchId, exchangeNo])
  @@index([businessId, branchId, txnDate])
  @@index([businessId, partyId])
}

model ExchangeLine {
  id         Int      @id @default(autoincrement())
  exchangeId Int
  weight     Decimal  @db.Decimal(14, 3)
  touch      Decimal  @db.Decimal(6, 3)
  fine       Decimal  @db.Decimal(14, 3)
  serialNo   String?
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([exchangeId])
}

model KachaProcess {
  id          Int              @id @default(autoincrement())
  businessId  Int
  branchId    Int
  type        KachaProcessType
  metal       MetalKind
  txnDate     DateTime         @db.Date
  /// kacha fine consumed
  inFine      Decimal          @db.Decimal(14, 3)
  /// bullion fine produced (melt weight / refined bread)
  outFine     Decimal          @db.Decimal(14, 3)
  /// REFINE: residue that stays kacha
  ravalFine   Decimal          @default(0) @db.Decimal(14, 3)
  /// inFine − outFine − ravalFine (process loss; negative = gain)
  difference  Decimal          @db.Decimal(14, 3)
  exchangeId  Int?
  remark      String?
  reverted    Boolean          @default(false)
  createdById Int?
  createdAt   DateTime         @default(now())

  @@index([businessId, branchId, metal, txnDate])
}

model BuySell {
  id            Int           @id @default(autoincrement())
  businessId    Int
  branchId      Int
  buySellNo     Int
  side          TradeSide
  partyId       Int
  metal         MetalKind
  txnDate       DateTime      @db.Date
  /// Σ line weight (bullion fine)
  totalWeight   Decimal       @db.Decimal(14, 3)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  /// Σ line amount − discount
  totalAmount   Decimal       @db.Decimal(14, 2)
  cash          Decimal       @default(0) @db.Decimal(14, 2)
  online        Decimal       @default(0) @db.Decimal(14, 2)
  bankAccountId Int?
  bhavBookingId Int?
  narration     String?
  createdById   Int?
  createdAt     DateTime      @default(now())
  lines         BuySellLine[]

  @@unique([businessId, branchId, buySellNo])
  @@index([businessId, branchId, txnDate])
  @@index([businessId, partyId])
  @@index([bhavBookingId])
}

model BuySellLine {
  id        Int     @id @default(autoincrement())
  buySellId Int
  weight    Decimal @db.Decimal(14, 3)
  /// settings units
  rate      Decimal @db.Decimal(14, 2)
  amount    Decimal @db.Decimal(14, 2)
  buySell   BuySell @relation(fields: [buySellId], references: [id], onDelete: Cascade)

  @@index([buySellId])
}

model BhavBooking {
  id            Int               @id @default(autoincrement())
  businessId    Int
  branchId      Int
  bookingNo     Int
  side          TradeSide
  partyId       Int
  metal         MetalKind
  txnDate       DateTime          @db.Date
  weight        Decimal           @db.Decimal(14, 3)
  /// settings units, locked
  rate          Decimal           @db.Decimal(14, 2)
  amount        Decimal           @db.Decimal(14, 2)
  /// advance received (party credit until delivered)
  cash          Decimal           @default(0) @db.Decimal(14, 2)
  online        Decimal           @default(0) @db.Decimal(14, 2)
  bankAccountId Int?
  /// weight − delivered via buy-sell
  pendingWeight Decimal           @db.Decimal(14, 3)
  status        BhavStatus        @default(PENDING)
  /// TASK-97: ONLY_ENTRY = no ledger/udhar posting for the advance
  entryType     BhavEntryType     @default(LEDGER)
  verifiedAt    DateTime?
  verifiedById  Int?
  lines         BhavBookingLine[]
  narration     String?
  createdById   Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([businessId, branchId, bookingNo])
  @@index([businessId, branchId, status])
  @@index([businessId, partyId])
}

// ───────────── Phase 11: schemes (saving plans) + Anjuman (docs/api-phase11.md) ─────────────

enum SchemeKind {
  SAVING
  ANJUMAN
}

enum SchemeType {
  CASH
  GOLD
}

enum SchemeBonusType {
  NONE
  ONE_EMI
  PERCENT
  FIXED
}

/// matured is derived (EMIs paid ≥ tenure), not stored
enum SchemeEnrollmentStatus {
  ACTIVE
  WON
  WITHDRAWN
  CLOSED
}

/// CASH/ONLINE/TOKEN move money (ledger IN); DRAW/VENDOR count as paid with no money moved
enum SchemePayMedium {
  CASH
  ONLINE
  TOKEN
  DRAW
  VENDOR
}

model Scheme {
  id           Int                @id @default(autoincrement())
  businessId   Int
  branchId     Int
  kind         SchemeKind         @default(SAVING)
  type         SchemeType
  name         String
  description  String?
  emiAmount    Decimal            @db.Decimal(14, 2)
  tenureMonths Int
  bonusType    SchemeBonusType    @default(NONE)
  /// PERCENT: % of paid (₹ or g); FIXED: ₹ (CASH) or g (GOLD)
  bonusValue   Decimal            @default(0) @db.Decimal(14, 3)
  startDate    DateTime           @db.Date
  validityDate DateTime?          @db.Date
  isActive     Boolean            @default(true)
  createdById  Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  groups       SchemeGroup[]
  enrollments  SchemeEnrollment[]

  @@index([businessId, branchId, kind, isActive])
}

model SchemeGroup {
  id          Int                @id @default(autoincrement())
  schemeId    Int
  name        String
  memberLimit Int?
  createdAt   DateTime           @default(now())
  scheme      Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  enrollments SchemeEnrollment[]

  @@unique([schemeId, name])
}

model SchemeEnrollment {
  id          Int                    @id @default(autoincrement())
  businessId  Int
  branchId    Int
  schemeId    Int
  groupId     Int?
  partyId     Int
  assignId    String
  displayName String
  emiAmount   Decimal                @db.Decimal(14, 2)
  startDate   DateTime               @db.Date
  status      SchemeEnrollmentStatus @default(ACTIVE)
  /// redeem / withdraw: ₹ credited to the party (udhar); GOLD also grams + rate used
  redeemValue Decimal?               @db.Decimal(14, 2)
  redeemFine  Decimal?               @db.Decimal(14, 3)
  redeemRate  Decimal?               @db.Decimal(14, 2)
  closedAt    DateTime?
  createdById Int?
  createdAt   DateTime               @default(now())
  scheme      Scheme                 @relation(fields: [schemeId], references: [id])
  group       SchemeGroup?           @relation(fields: [groupId], references: [id])
  payments    SchemePayment[]

  @@unique([schemeId, assignId])
  @@index([businessId, branchId, schemeId, status])
  @@index([businessId, partyId])
  @@index([groupId])
}

model SchemePayment {
  id            Int              @id @default(autoincrement())
  enrollmentId  Int
  /// installment 1..tenure; null for TOKEN / ad-hoc and after reversal (many NULLs allowed → a reversed month can be repaid)
  emiNo         Int?
  emiDate       DateTime?        @db.Date
  txnDate       DateTime         @db.Date
  amount        Decimal          @db.Decimal(14, 2)
  medium        SchemePayMedium  @default(CASH)
  bankAccountId Int?
  /// GOLD schemes: rate in settings units (gold /10 g) and the fine bought, 3 dp
  rate          Decimal?         @db.Decimal(14, 2)
  fine          Decimal?         @db.Decimal(14, 3)
  remark        String?
  isReversed    Boolean          @default(false)
  createdById   Int?
  createdAt     DateTime         @default(now())
  enrollment    SchemeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, emiNo])
  @@index([enrollmentId])
}

// ═════════════ TASK-87 — permission enquiries (staff ask for access, a manager decides) ═════════════

enum EnquiryStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A staff request for view/edit/delete on one page permission. Reviewers see only requesters inside their
/// branch subtree; one PENDING per (user, permission) is enforced in the service under an advisory lock.
model PermissionEnquiry {
  id           Int           @id @default(autoincrement())
  businessId   Int
  userId       Int
  permissionId Int
  wantView     Boolean       @default(false)
  wantEdit     Boolean       @default(false)
  wantDelete   Boolean       @default(false)
  reason       String?
  status       EnquiryStatus @default(PENDING)
  decidedById  Int?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  @@index([businessId, status])
  @@index([userId, permissionId, status])
}

// ───────────── TASK-97 (developer1) additive models ─────────────

enum BhavEntryType {
  LEDGER
  ONLY_ENTRY
}

enum ItcEligibility {
  ELIGIBLE
  BLOCKED_17_5
  INELIGIBLE
}

enum GstSupplyCategory {
  TAXABLE
  ZERO_RATED
  NIL_EXEMPT
  NON_GST
}

/// Optional weight/rate rows of a bhav booking; booking.weight/amount are their sums.
model BhavBookingLine {
  id        Int         @id @default(autoincrement())
  bookingId Int
  weight    Decimal     @db.Decimal(14, 3)
  rate      Decimal     @db.Decimal(14, 2)
  amount    Decimal     @db.Decimal(14, 2)
  booking   BhavBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// Split payment rows for trade docs (EXCHANGE | BUY_SELL | BHAV); totals still live on the doc.
model TradePayment {
  id            Int             @id @default(autoincrement())
  businessId    Int
  docType       String
  docId         Int
  mode          BillPaymentMode
  amount        Decimal         @db.Decimal(14, 2)
  bankAccountId Int?
  reference     String?
  createdAt     DateTime        @default(now())

  @@index([businessId, docType, docId])
}

model TagTemplate {
  id          Int          @id @default(autoincrement())
  businessId  Int
  name        String
  widthMm     Decimal      @db.Decimal(6, 2)
  heightMm    Decimal      @db.Decimal(6, 2)
  shape       String       @default("RECT")
  direction   String       @default("HORIZONTAL")
  neckWidthMm Decimal?     @db.Decimal(6, 2)
  elements    Json
  appliesTo   StockClass[]
  isActive    Boolean      @default(false)
  createdById Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([businessId])
}

model SetStockLog {
  id         Int      @id @default(autoincrement())
  businessId Int
  branchId   Int
  card       String
  oldBalance Decimal  @db.Decimal(16, 3)
  newBalance Decimal  @db.Decimal(16, 3)
  remarks    String?
  userId     Int?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

model RepairConsumable {
  id           Int      @id @default(autoincrement())
  businessId   Int
  branchId     Int
  name         String
  category     String?
  unit         String   @default("pcs")
  currentStock Decimal  @default(0) @db.Decimal(14, 3)
  minLevel     Decimal  @default(0) @db.Decimal(14, 3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, branchId])
}

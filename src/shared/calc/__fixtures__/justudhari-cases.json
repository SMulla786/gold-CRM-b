    "settings": {
      "sell_calculation_basis": "net",
      "purchase_calculation_basis": "net",
      "amount_based_rate": "OFF (enter rate -> calc total)",
      "rate_units": {
        "gold": "per 10 gram",
        "silver": "per 1000 gram (1 kg)"
      },
      "caret_to_tunch_pct": {
        "18": 75,
        "20": 83.33,
        "22": 91.67,
        "24": 100
      },
      "silver_touch_examples": {
        "800": 80,
        "925": 92.5,
        "999": 100
      },
      "gst_split": "intra-state -> cgst = sgst = gst/2, igst = 0 (customer_is_intra_state default true)"
    },
    "legend": {
      "input": {
        "metal": "gold|silver — sets the rate unit (gold /10gm, silver /1kg) on SELL",
        "caret": "gold karat 24/22/20/18 — drives default tunch% when tunch omitted",
        "tunch": "touch/purity %. Gold: overrides caret default. Silver: the purity",
        "wstg": "wastage % added to fine",
        "chrg": "stone charge (Rs, flat)",
        "rate": "SELL: metal rate in the unit above (gold /10gm, silver /1kg). PURCHASE: applied per-gram (net*rate)",
        "lbr/lbrunit": "labour; unit r=Rs flat, w=Rs per gram (x gross), p=% (gross*%*perGramRate)",
        "disc/discunit": "line discount; r=Rs, p=% of item_cost",
        "bill_disc/bill_disc_unit": "bill-level discount; r=Rs, p=%",
        "gst": "GST % (user-typed). Intra-state split into cgst+sgst",
        "bill_type": "g = GST bill, e = ROUGH/estimate"
      },
      "output": "net, fine, ttl (line total), sub (subtotal), cgst_val, sgst_val, igst_val, round (round-off), total (pre-round grand), final (rounded payable). Strings exactly as the app renders."
    },
    "notes": [
      "SELL item_cost = net * (rate / rateUnit); rateUnit gold=10, silver=1000.",
      "PURCHASE item_cost = net * rate (rate entered per-gram; the live purchase calc does NOT divide by a unit).",
      "PURCHASE billtotal adds GST into total but does NOT populate the cgst/sgst/igst split fields (left empty).",
      "GST on a bill with a line/bill discount is charged on the discounted (taxable) base.",
      "ROUGH bills (bill_type=e) do not force a GST%; GST applies only if the user types one.",
      "keep_balance (money<->metal via due_metal_rate) is NOT captured here — it is a payment-panel conversion (moneyToMetal/metalToMoney), separate from line/summary calc. Flagged for a follow-up capture if the engine needs it."
    ],
